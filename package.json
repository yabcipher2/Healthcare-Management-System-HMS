{
  "name": "healthcare-management-system",
  "version": "1.0.0",
  "description": "Healthcare Management System with integrated modules for patient care, pharmacy, laboratory, and administration",
  "main": "backend/server.js",
  "scripts": {
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:all": "npm run install:backend && npm run install:frontend",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "cd frontend && npm run build",
    "start:backend": "cd backend && npm start",
    "start": "npm run build:frontend && npm run start:backend",
    "test:connection": "node backend/scripts/test-db-connection.js",
    "diagnose:network": "node backend/scripts/diagnose-network.js",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "deploy": "npm run build:frontend && docker-compose up -d --build"
  },
  "keywords": [
    "healthcare",
    "hospital",
    "management",
    "system",
    "medical"
  ],
  "author": "HMS Development Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
