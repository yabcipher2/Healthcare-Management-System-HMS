# Copy to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-string

# ── Local MongoDB (default when MONGO_URI is unset) ──────────────────────────
# MONGO_URI=mongodb://127.0.0.1:27017/mesra_hms

# ── MongoDB Atlas ────────────────────────────────────────────────────────────
# Atlas → Connect → Drivers → copy the string and replace <db_password>.
# Keep the database name (/mesra_hms) and URL-encode special characters in the
# password (@ : / ? # [ ] % -> e.g. p@ss -> p%40ss).
# MONGO_URI=mongodb+srv://<db-user>:<db_password>@<cluster>.mongodb.net/mesra_hms?retryWrites=true&w=majority

# MONGODB_URI is read when MONGO_URI is empty.
# MONGODB_URI=mongodb+srv://<db-user>:<db_password>@<cluster>.mongodb.net/mesra_hms?retryWrites=true&w=majority
